# Downtown Luka — Hostinger API Router
# Routes all /api/* requests to api.php

RewriteEngine On

# ─── Security: block direct download of private files ───────────────────────
# users.json (passwords), invoices.json / active_orders.json / sms_sent.json
# (customer names and phone numbers), logs, scripts and dev files can only be
# read through api.php, never by typing the file name in a browser.
<FilesMatch "\.(json|log|py|pyc|ps1|md|txt|zip|pdf|sh|bak|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block hidden files (.git, .gitignore, .htaccess, .env …)
RewriteRule (^|/)\. - [F,L]

# Block the Python dev-server cache folder
RewriteRule ^__pycache__(/|$) - [F,L]

# ─── Caching: always fetch fresh pages, scripts and styles after a deploy ───
# (Stops Hostinger/LiteSpeed and browsers serving an old admin.js with a new admin.html)
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(css|js|svg)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
# Tell Hostinger's LiteSpeed page cache not to store any page of this app
<IfModule LiteSpeed>
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# No folder listings
Options -Indexes

# Redirect /api/anything to api.php?route=anything
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
